    "build": "npm run build --workspace=apps/agent-hooks"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "ikisatsuPluginVersions": {
    "ikisatsu": "0.6.1",
    "ikisatsu-codex": "0.6.1"
  }
}
