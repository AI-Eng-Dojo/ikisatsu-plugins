{
  "name": "ikisatsu-plugins",
  "private": true,
  "type": "module",
  "description": "ikisatsu(経緯)の配布用ソース。プラグイン 2 つと hooks / core。サーバは含まない",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.18.0"
  },
